{
  "project": "AETHELGRAD",
  "stage": "stage-1-forest-launch",
  "unit": "MiB",
  "target_total_mib": 1024,
  "policy": {
    "padding_files_for_size": false,
    "asset_packs_are_read_only_at_runtime": true,
    "every_binary_asset_requires_source_and_license": true,
    "budgets_are_uncompressed_source_targets_before_platform_compression": true,
    "stage_budget_is_a_plan_not_an_installed_size": true,
    "full_content_budget_file": "assets/full_content_budget.json",
    "documented_per_dynamic_pack_ceiling_mib": 512,
    "bundled_world_playable_without_optional_archive": true,
    "required_before_online_start": false,
    "delivery_mode": "bundled-launch-slice-and-play-asset-delivery",
    "distribution": "staged-phone-first-release"
  },
  "packs": [
    {"module": "assetpack_core", "delivery": "install-time", "target_mib": 96, "content": "bootstrap UI, online authentication, launch scene and content catalog"},
    {"module": "assetpack_graphics_base", "delivery": "on-demand", "target_mib": 160, "content": "mobile forest materials, base shaders, shared meshes and renderer resources"},
    {"module": "assetpack_forest", "delivery": "fast-follow", "target_mib": 160, "content": "forest launch region, water, collision and navigation slice"},
    {"module": "assetpack_characters", "delivery": "on-demand", "target_mib": 144, "content": "Stage 1 Aurora character palette, runtime contract and animation bindings"},
    {"module": "assetpack_audio_hd", "delivery": "on-demand", "target_mib": 128, "content": "Stage 1 forest ambience, UI, movement and combat audio"},
    {"module": "assetpack_shaders_gles", "delivery": "on-demand", "target_mib": 96, "content": "OpenGL ES mobile shader and material contract"},
    {"module": "assetpack_world_streaming", "delivery": "on-demand", "target_mib": 96, "content": "Stage 1 forest sector streaming descriptor"},
    {"module": "assetpack_terrain_lod", "delivery": "on-demand", "target_mib": 64, "content": "Stage 1 forest heightfield and terrain LOD data"},
    {"module": "assetpack_animation_sets", "delivery": "on-demand", "target_mib": 48, "content": "Stage 1 locomotion and combat motion contract"},
    {"module": "assetpack_foliage_lods", "delivery": "on-demand", "target_mib": 32, "content": "Stage 1 foliage cluster and mobile LOD data"},
    {"module": "assetpack_sand", "delivery": "deferred", "target_mib": 0, "content": "Future expansion: sand biome"},
    {"module": "assetpack_snow", "delivery": "deferred", "target_mib": 0, "content": "Future expansion: snow biome"},
    {"module": "assetpack_cinematics", "delivery": "deferred", "target_mib": 0, "content": "Future expansion: story cinematics"},
    {"module": "assetpack_hd_textures", "delivery": "deferred", "target_mib": 0, "content": "Future expansion: high-resolution textures"},
    {"module": "assetpack_dungeons", "delivery": "deferred", "target_mib": 0, "content": "Future expansion: dungeon cells"},
    {"module": "assetpack_vfx", "delivery": "deferred", "target_mib": 0, "content": "Future expansion: Niagara and weather effects"},
    {"module": "assetpack_voice", "delivery": "deferred", "target_mib": 0, "content": "Future expansion: dialogue and localization voice"},
    {"module": "assetpack_shaders_vulkan", "delivery": "deferred", "target_mib": 0, "content": "Future expansion: Vulkan shader libraries"},
    {"module": "assetpack_pipeline_cache", "delivery": "deferred", "target_mib": 0, "content": "Future expansion: device pipeline cache seeds"}
  ]
}
