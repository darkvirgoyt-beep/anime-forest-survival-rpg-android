PORT=8080
DATABASE_URL=postgres://aethelgard:aethelgard_dev@localhost:5432/aethelgard
DATABASE_SSL=true
# Render PostgreSQL uses a self-signed certificate; set true only when a trusted CA is configured.
DATABASE_SSL_VERIFY=false
# Web OAuth client ID used as the expected audience of Android Google ID tokens. This is not a secret.
GOOGLE_ID_TOKEN_AUDIENCE=REPLACE_WITH_WEB_OAUTH_CLIENT_ID
# Optional future Play Games route. Leave both values unset until Play Console is configured.
GOOGLE_GAME_SERVER_CLIENT_ID=
GOOGLE_GAME_SERVER_CLIENT_SECRET=
GAME_SESSION_JWT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
GAME_ACCESS_TOKEN_TTL_SECONDS=900
GAME_REFRESH_TOKEN_TTL_SECONDS=2592000
# Absolute paths on the private server host; do not commit the archive or manifest.
PRIVATE_CONTENT_MANIFEST_PATH=/srv/aethelgard-content/high/manifest.json
PRIVATE_CONTENT_ARCHIVE_PATH=/srv/aethelgard-content/high/main.5.com.darkvirgoyt.aethelgrand.obb
ALLOWED_ORIGIN=https://your-aethelgard-game-domain.example
